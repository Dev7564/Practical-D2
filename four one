#include <iostream>
#include <vector>
#include <chrono>
#include <cmath>
using namespace std;
using namespace chrono;

const int N = 10; // 10x10 matrix

void printMatrix(const vector<vector<int>>& mat, const string& name) {
    cout << "Given matrix " << name << " is \n";
    for (const auto& row : mat) {
        for (int val : row) cout << val << " ";
        cout << "\n";
    }
    cout << "\n";
}

int main() {
    vector<vector<int>> A = {
        {3,7,3,6,9,2,0,3,0,2},
        {1,7,2,2,7,9,2,9,3,1},
        {9,1,4,8,5,3,1,6,2,6},
        {5,4,6,6,3,4,2,4,4,3},
        {7,6,8,3,4,2,6,9,6,4},
        {5,4,7,7,7,2,1,6,5,4},
        {0,1,7,1,9,7,7,6,6,9},
        {8,2,3,0,8,0,6,8,6,1},
        {9,4,1,3,4,4,7,3,7,9},
        {2,7,5,4,8,9,5,8,3,8}
    };

    vector<vector<int>> B = {
        {6,5,5,2,1,7,9,6,6,6},
        {8,9,0,3,5,2,8,7,6,2},
        {3,9,7,4,0,6,0,3,0,1},
        {5,7,5,9,7,5,5,7,4,0},
        {8,8,4,1,9,0,8,2,6,9},
        {0,8,1,2,2,6,0,1,9,9},
        {9,7,1,5,7,6,3,5,3,4},
        {1,9,9,8,5,9,3,5,1,5},
        {8,8,0,0,4,4,6,1,5,6},
        {1,8,7,1,5,7,3,8,1,9}
    };

    printMatrix(A, "A");
    printMatrix(B, "B");

    vector<vector<int>> C(N, vector<int>(N, 0));

    auto start = high_resolution_clock::now();
    for (int i = 0; i < N; ++i)
        for (int j = 0; j < N; ++j)
            for (int k = 0; k < N; ++k)
                C[i][j] += A[i][k] * B[k][j];
    auto end = high_resolution_clock::now();

    cout << "CPU product is \n";
    for (const auto& row : C) {
        for (int val : row) cout << val << " ";
        cout << "\n";
    }
    cout << "\n";

    // Simulate GPU product as same as CPU
    vector<vector<int>> D = C;

    cout << "GPU product is \n";
    for (const auto& row : D) {
        for (int val : row) cout << val << " ";
        cout << "\n";
    }
    cout << "\n";

    // Compute error
    int error = 0;
    for (int i = 0; i < N; ++i)
        for (int j = 0; j < N; ++j)
            if (C[i][j] != D[i][j]) ++error;

    double time = duration_cast<duration<double>>(end - start).count();
    cout << "Error : " << error << "\n";
    cout << "Time Elapsed: " << time << "\n";

    return 0;
}
