#include <iostream> 
#include <vector>
 #include <cstdlib> 
#include <chrono> 
#include <omp.h> 
 
using namespace std; using namespace chrono; 
 
void bubbleSortSeq(vector<int>& arr) { 
    int n = arr.size();     
    for (int i = 0; i < n - 1; ++i)  
           for (int j = 0; j < n - i - 1; ++j)    
                 if (arr[j] > arr[j + 1])         
                         swap(arr[j], arr[j + 1]); 
} 
 
void bubbleSortPar(vector<int>& arr) { 
    int n = arr.size();   
      for (int i = 0; i < n - 1; ++i) {       
          #pragma omp parallel for 
          for (int j = i % 2; j < n - 1; j += 2) {     
                    if (arr[j] > arr[j + 1])           
                          swap(arr[j], arr[j + 1]); 
        } 
    } 
} 
void printArray(const vector<int>& arr) { 
    for (int i = 0; i < arr.size(); ++i) {       
          cout << arr[i];       
            if (i != arr.size() - 1) 
            cout << ", "; 
    } 
    cout << "\n"; 
} 
 
